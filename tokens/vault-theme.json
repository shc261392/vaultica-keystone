{
  "$metadata": {
    "description": "App-level vault theme tokens (blink default + paper override) — Tailwind v4 @theme SoT",
    "version": "1.0.0"
  },
  "theme": {
    "blink": {
      "--color-electric-50": "#e0ffff",
      "--color-electric-100": "#b2ffff",
      "--color-electric-200": "#6ffbff",
      "--color-electric-300": "#00F0FF",
      "--color-electric-400": "#00CDDB",
      "--color-electric-500": "#00A7B3",
      "--color-electric-600": "#007f8a",
      "--color-electric-700": "#005A61",
      "--color-electric-800": "#003840",
      "--color-electric-900": "#001f24",
      "--color-neon-yellow-300": "#ffff99",
      "--color-neon-yellow-400": "#FFFF33",
      "--color-neon-yellow-500": "#FFFD37",
      "--color-neon-yellow-600": "#d4d200",
      "--color-neon-yellow-700": "#9e9900",
      "--color-magenta-200": "#ff80ff",
      "--color-magenta-400": "#FF00FF",
      "--color-magenta-600": "#CC00CC",
      "--color-magenta-800": "#660066",
      "--color-magenta-950": "#280028",
      "--color-silver-200": "#ebebeb",
      "--color-silver-400": "#C4C4C4",
      "--color-silver-600": "#8A8A8A",
      "--color-silver-800": "#484848",
      "--color-vault-surface-primary": "#070d10",
      "--color-vault-surface-secondary": "#0c1820",
      "--color-vault-surface-tertiary": "#122530",
      "--color-vault-surface-overlay": "#1a3040",
      "--color-vault-border-default": "#1a3040",
      "--color-vault-border-strong": "#00A7B3",
      "--color-vault-border-subtle": "rgba(0, 240, 255, 0.07)",
      "--color-vault-border-focus": "#00F0FF",
      "--color-vault-text-primary": "#e4f8ff",
      "--color-vault-text-secondary": "#C4C4C4",
      "--color-vault-text-tertiary": "#5a8a92",
      "--color-vault-text-accent": "#00F0FF",
      "--color-cta-primary": "#00F0FF",
      "--color-cta-primary-fg": "#070d10",
      "--color-vault-accent": "var(--color-cta-primary)",
      "--color-vault-accent-fg": "var(--color-cta-primary-fg)",
      "--color-vault-accent-hover": "#00CDDB",
      "--color-vault-accent-active": "#00A7B3",
      "--color-vault-accent-subtle": "rgba(0, 240, 255, 0.10)",
      "--color-vault-accent-glow": "rgba(0, 240, 255, 0.12)",
      "--color-vault-status-success": "#22c55e",
      "--color-vault-status-success-subtle": "rgba(34, 197, 94, 0.12)",
      "--color-vault-status-warning": "#FFFD37",
      "--color-vault-status-warning-subtle": "rgba(255, 253, 55, 0.12)",
      "--color-vault-status-critical": "#FF00FF",
      "--color-vault-status-critical-subtle": "rgba(255, 0, 255, 0.12)",
      "--color-vault-status-info": "#00F0FF",
      "--color-vault-status-info-subtle": "rgba(0, 240, 255, 0.10)",
      "--color-cite-vault": "#5aa2ff",
      "--color-cite-vault-subtle": "rgba(90, 162, 255, 0.14)",
      "--color-cite-web": "#f97316",
      "--color-cite-web-subtle": "rgba(249, 115, 22, 0.14)",
      "--radius-sm": "6px",
      "--radius-md": "10px",
      "--radius-lg": "16px",
      "--radius-full": "9999px",
      "--color-vault-bg-primary": "var(--color-vault-surface-secondary)",
      "--color-vault-text-muted": "var(--color-vault-text-tertiary)"
    },
    "paper": {
      "color-scheme": "light",
      "--color-vault-surface-primary": "#f7f7f4",
      "--color-vault-surface-secondary": "#ffffff",
      "--color-vault-surface-tertiary": "#eef0f4",
      "--color-vault-surface-overlay": "#e2e6ee",
      "--color-vault-border-default": "#e2e4ea",
      "--color-vault-border-strong": "#007f8a",
      "--color-vault-border-subtle": "rgba(0, 127, 138, 0.1)",
      "--color-vault-border-focus": "#007f8a",
      "--color-vault-text-primary": "#14161c",
      "--color-vault-text-secondary": "#3f434f",
      "--color-vault-text-tertiary": "#8b90a0",
      "--color-vault-text-accent": "#007f8a",
      "--color-cta-primary": "#007f8a",
      "--color-cta-primary-fg": "#ffffff",
      "--color-vault-accent": "#007f8a",
      "--color-vault-accent-fg": "#ffffff",
      "--color-vault-accent-hover": "#00A7B3",
      "--color-vault-accent-active": "#005A61",
      "--color-vault-accent-subtle": "rgba(0, 127, 138, 0.08)",
      "--color-vault-accent-glow": "rgba(0, 127, 138, 0.16)",
      "--color-vault-status-info": "#007f8a",
      "--color-semantic-vault-border-focus": "#007f8a",
      "--color-vault-bg-primary": "#ffffff",
      "--color-cite-vault": "#0b6fb0",
      "--color-cite-vault-subtle": "rgba(11, 111, 176, 0.12)"
    }
  }
}
