      "--shadow-xl": "0 12px 32px rgb(16 18 22 / 0.12), 0 0 0 1px rgb(16 18 22 / 0.05)",
      "--shadow-2xl": "0 12px 32px rgb(16 18 22 / 0.12), 0 0 0 1px rgb(16 18 22 / 0.05)"
