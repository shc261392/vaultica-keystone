{
  "$metadata": {
    "description": "App-level vault theme tokens (blink dark default + paper light override) - Tailwind v4 @theme SoT. Calm tool-like palette (\"Quiet instrument\"); v2.1 adds accent-ring, drops legacy neon/electric/magenta/silver scales.",
    "version": "2.1.0"
  },
  "theme": {
    "blink": {
      "--color-vault-surface-primary": "#0E1013",
      "--color-vault-surface-secondary": "#141619",
      "--color-vault-surface-tertiary": "#1B1E23",
